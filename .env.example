# Copy to .env.local and fill. Never commit real values.
# The authoritative list lives in project-documents/15_Services_and_Credentials.md —
# keep the two in step, and delete the lines this product does not use.

# --- Supabase ---
SUPABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-side only — never VITE_-prefixed, never in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Healthchecks.io ---
HEALTHCHECKS_PING_URL=

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Postgres (Supabase) ---
# Dashboard -> "Connect" button at the TOP of the project page (not in Settings).
# Pick "Session pooler", NOT "Direct connection":
#   direct  db.<ref>.supabase.co:5432          user postgres            <- IPv6 only without the IPv4 add-on
#   session aws-<region>.pooler.supabase.com:5432  user postgres.<ref>  <- IPv4, works from GitHub runners
#   transaction  same host :6543                                        <- do not use, no session state
# Replace [YOUR-PASSWORD] with the database password from project creation.
DATABASE_URL=
